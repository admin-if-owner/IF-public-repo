# Azure Authentication Environment Variables
# Used for local development and Terraform backend authentication
# NOTE: For GitHub Actions CI/CD, these are stored as GitHub Secrets

# Your Azure subscription ID
# Get from: az account show --query id -o tsv
export TF_VAR_subscription_id=""

# Required for OIDC authentication with Terraform Azure provider
# Get from GitHub repo → Settings → Secrets and Variables → Actions
# Value: AZURE_CLIENT_ID secret
export ARM_CLIENT_ID=""

# Azure Tenant ID
# Get from: az account show --query tenantId -o tsv
export ARM_TENANT_ID=""

# Azure Subscription ID (must match TF_VAR_subscription_id)
export ARM_SUBSCRIPTION_ID=""

# Terraform remote-state backend
export TF_BACKEND_RESOURCE_GROUP="rg-terraform-state"
export TF_BACKEND_STORAGE_ACCOUNT="stterraformstate83417ead"
export TF_BACKEND_CONTAINER="tfstate"
export TF_BACKEND_KEY="dev.tfstate"

# Optional: Set which Terraform environment you're working with
# export TF_WORKSPACE="dev"  # or "prod"
